{
  "manifest_version": 3,
  "name": "Planbar – Todo Planer",
  "version": "2.0.0",
  "description": "Plane Aufgaben tage-, wochen- und monatsweise in einem modernen Chrome Side Panel.",
  "permissions": ["storage", "sidePanel", "notifications", "alarms", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Planbar öffnen",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "116"
}
